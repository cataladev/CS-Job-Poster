# Local development / staging bot only. Never use main-server channel IDs here.
# Prefer a separate Discord application/token and a dedicated test server.
# Change this to [name]_dev for local testing (e.g. arthur_dev).
BOT_ENV=yourname_dev
DISCORD_TOKEN=replace-with-dev-bot-token
DISCORD_CHANNEL_ID=replace-with-dev-internship-channel-id
DISCORD_NEW_GRAD_CHANNEL_ID=replace-with-dev-new-grad-channel-id
DISCORD_LOG_CHANNEL_ID=replace-with-dev-log-channel-id

# Permanent category cards and threads in the consolidated development channels.
# Also grant Read Message History, Create Public Threads, Send Messages in Threads.
OUTSOURCE_INTERNSHIP_CHANNEL_ID=1546612310225854504
OUTSOURCE_NEW_GRAD_CHANNEL_ID=1546612347693699183

# Dedicated local database. `make postgres-up` starts it with Docker.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
POSTGRES_DB=jobbot_dev
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=replace-with-local-dev-password
DATABASE_URL=postgresql://jobbot:replace-with-local-dev-password@localhost:5432/jobbot_dev

# Keep test-server volume controlled while exercising the real five-minute path.
# How often the collector wakes. Each feed still honors its own cadence, so this
# only needs to match the fastest one (Jobright, 60s); the GitHub repository
# feeds stay on their own five-minute interval regardless.
POLL_INTERVAL_SECONDS=60
DIRECT_ATS_POLL_INTERVAL_SECONDS=900
COMPANY_SOURCE_POLL_INTERVAL_SECONDS=3600
DIGEST_INTERVAL_SECONDS=14400
DISCORD_INTERNSHIP_ALERT_ROLE_ID=
DISCORD_NEW_GRAD_ALERT_ROLE_ID=
RECENT_CATCHUP_HOURS=0

# Optional: Jobright egress. Point at a proxy list file (one per line, the provider's
# own export format) when Jobright has stopped serving this address; empty means the
# host's own address.
JOBRIGHT_PROXY_FILE=
JOBRIGHT_PROXY_URLS=
JOBRIGHT_PROXY_USERNAME=
JOBRIGHT_PROXY_PASSWORD=

# Optional webhook for standalone scraper tools. The posting runtime sends Jobright
# health and session alerts to the permanent Core feeds thread in DISCORD_LOG_CHANNEL_ID.
# Standalone tools log locally when unset.
JOBRIGHT_STATUS_WEBHOOK_URL=

# Optional: sign-in cookie used only to resolve a Jobright listing to the employer's
# own application URL. Without it every Jobright link stays a jobright.ai link, which
# is how the bot behaved before this existed. Copy the SESSION_ID cookie value from a
# signed-in jobright.ai browser session. It expires; when it does the bot says so once
# and falls back, and a fresh value takes effect on the next restart.
JOBRIGHT_SESSION_ID=

# Optional: Discord user id pinged when Jobright goes down or its session expires --
# failures only, never on recovery or a self-healing egress rotation. Right-click your
# name in Discord with Developer Mode on to copy it. @everyone and @here stay
# impossible regardless of what is set here.
JOBRIGHT_ALERT_USER_ID=

REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
SOURCE_CONCURRENCY=4
PUBLISH_DELAY_SECONDS=1.0
LOG_LEVEL=INFO
USER_AGENT=cs-job-poster/dev

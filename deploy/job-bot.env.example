# Required Discord configuration
DISCORD_TOKEN=replace-me
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_NEW_GRAD_CHANNEL_ID=234567890123456789

# Postgres
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
POSTGRES_DB=jobbot
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://jobbot:replace-with-a-long-random-password@localhost:5432/jobbot

# Runtime
POLL_INTERVAL_SECONDS=300
# A single digest is posted after this interval; individual job posts remain immediate.
DIGEST_INTERVAL_SECONDS=14400
# Optional: roles mentioned only in their track's digest (requires Mention Everyone).
DISCORD_INTERNSHIP_ALERT_ROLE_ID=
DISCORD_NEW_GRAD_ALERT_ROLE_ID=
RECENT_CATCHUP_HOURS=48
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
SOURCE_CONCURRENCY=6
PUBLISH_DELAY_SECONDS=1.0
LOG_LEVEL=INFO
USER_AGENT=cs-job-poster/2.0

# One-time SQLite import tooling only
SQLITE_DB_PATH=job_bot.db

# Required Discord configuration
DISCORD_TOKEN=replace-me
DISCORD_CHANNEL_ID=123456789012345678
DISCORD_NEW_GRAD_CHANNEL_ID=234567890123456789
DISCORD_LOG_CHANNEL_ID=345678901234567890

# Optional daily category cards with job threads (separate internship/new-grad views).
# Requires View Channel, Send Messages, Embed Links, Read Message History,
# Create Public Threads, and Send Messages in Threads. Blank disables that mirror.
OUTSOURCE_INTERNSHIP_CHANNEL_ID=
OUTSOURCE_NEW_GRAD_CHANNEL_ID=
# Calendar timezone for category cards and primary digests.
DIGEST_TIMEZONE=America/New_York

# Postgres (required by the production publisher)
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
POSTGRES_DB=jobbot
POSTGRES_USER=jobbot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://jobbot:replace-with-a-long-random-password@localhost:5432/jobbot

# Polling and delivery
# How often the collector wakes. Each feed still honors its own cadence, so this
# only needs to match the fastest one (Jobright, 60s); the GitHub repository
# feeds stay on their own five-minute interval regardless.
POLL_INTERVAL_SECONDS=60
# Public employer ATS boards are independently throttled (minimum: 300 seconds).
DIRECT_ATS_POLL_INTERVAL_SECONDS=900
# A single digest is posted after this interval; individual job posts remain immediate.
DIGEST_INTERVAL_SECONDS=14400
# Optional: roles mentioned only in their track's digest (requires Mention Everyone).
DISCORD_INTERNSHIP_ALERT_ROLE_ID=
DISCORD_NEW_GRAD_ALERT_ROLE_ID=
RECENT_CATCHUP_HOURS=48

# Optional: Jobright egress. Jobright throttles by source address, so a deployment it
# has stopped serving can send its Jobright requests -- and only those -- through ISP
# proxies. Point this at a list file with one proxy per line; the provider's own export
# format works unedited (host:port:user:pass, user:pass@host:port, host:port, or a full
# http:// URL). Leave empty to use the host's own address.
JOBRIGHT_PROXY_FILE=
# Short pools can be listed inline instead, comma-separated, in the same formats.
JOBRIGHT_PROXY_URLS=
# Used for entries that carry no credentials of their own.
JOBRIGHT_PROXY_USERNAME=
JOBRIGHT_PROXY_PASSWORD=

# Optional: where Jobright's status transitions are announced (a Discord webhook URL).
# Boot, degradation with the error and address, each egress rotation, and recovery.
# Unset means the same lines go to the application log only.
JOBRIGHT_STATUS_WEBHOOK_URL=

REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
SOURCE_CONCURRENCY=6
PUBLISH_DELAY_SECONDS=1.0
LOG_LEVEL=INFO
USER_AGENT=cs-job-poster/2.0

# Used only by isolated SQLite tests and one-time import tooling
SQLITE_DB_PATH=job_bot.db
